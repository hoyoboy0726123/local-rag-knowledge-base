# ── 環境與快取 ──────────────────────────────────────────────
venv/
__pycache__/
*.pyc
node_modules/
.env

# ── 資料庫 ─────────────────────────────────────────────────
# knowledge.db 內含 documents.content ——**每份文件解析後的完整全文**。
# 只排除原始檔而不排除資料庫是沒有用的，內容一樣會被帶出去。
# 首次啟動時 seed_data.py 會重建帳號與範例文件，建索引即可還原。
*.db
*.db-wal
*.db-shm

# ── 使用者上傳的文件 ────────────────────────────────────────
# 範例知識庫（12 份 Markdown）是 seed_data.py 生成的虛構內容，保留在版控裡。
# 但「未分類」是介面上傳的落點，會放進真實文件——一律排除，
# 避免把公司內部資料推上公開儲存庫。
sample_knowledge_base/未分類/

# ── 選配模型 ───────────────────────────────────────────────
# 重排序模型 571 MB，不進版控。需要時由管理端「模型與設定」一鍵下載。
models/

# ── 其他 ───────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
